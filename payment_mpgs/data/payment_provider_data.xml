<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_mpgs" model="payment.provider">
        <field name="name">Card (Mastercard Gateway)</field>
        <field name="code">mpgs</field>
        <field name="image_128" type="base64" file="payment_mpgs/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_mpgs"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="allow_tokenization">False</field>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment.payment_method_card'),
                         ref('payment.payment_method_visa'),
                         ref('payment.payment_method_mastercard'),
                     ])]"/>
    </record>

</odoo>
